# Banco: SQL Server pelo ODBC Driver 18 (instale o driver na maquina da aplicacao). No docker compose o host e "db".
# Instancia nomeada: mssql+aioodbc://bic:senha@SERVIDOR%5CINSTANCIA/bic?driver=... (%5C = barra invertida)
DATABASE_URL=mssql+aioodbc://bic:BicDev2026x@localhost:1433/bic?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# Login do painel web (pagina /login). Prefira guardar a senha como hash Argon2id: rode
# `uv run python -m app.auth.hashpw`, cole a linha ADMIN_PASSWORD_HASH gerada e remova ADMIN_PASSWORD.
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha
#ADMIN_PASSWORD_HASH=$argon2id$...
# Chave da API REST para integracoes (Power Automate etc.), header X-API-Key
API_KEY=troque-esta-chave

# Sessao do painel: chave que assina o cookie (gere uma aleatoria, ex.: `openssl rand -base64 48`).
# Vazia, uma chave nova e gerada a cada subida e todos precisam logar de novo apos reiniciar.
SECRET_KEY=
# Duracao da sessao (horas) e do "manter conectado" (dias)
SESSION_HOURS=8
SESSION_REMEMBER_DAYS=30
# Ligue quando o painel estiver atras de HTTPS (cookie Secure + HSTS)
COOKIE_SECURE=false
# Bloqueio apos N senhas erradas do mesmo IP, por M minutos
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Coletor
POLLER_ENABLED=true
# Timeout por requisicao Modbus. Deve ser >= ao "serial timeout" configurado no Link150 (padrao de fabrica 1 s);
# se for menor, a resposta atrasada de um medidor ausente chega fora de ordem.
MODBUS_TIMEOUT_S=1.0
MODBUS_RETRIES=0
LOG_LEVEL=INFO
