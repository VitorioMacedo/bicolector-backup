    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#f5f5f4"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#f5f5f4"
              }
            },
            "transparency": 0
          }
        ]
