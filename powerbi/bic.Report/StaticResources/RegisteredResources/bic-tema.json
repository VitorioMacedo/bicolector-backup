        "valueAxis": [
          {
            "gridlineColor": {
              "solid": {
                "color": "#e5e7eb"
              }
            },
            "labelColor": {
              "solid": {
                "color": "#6b7280"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#6b7280"
              }
            }
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#111827"
              }
